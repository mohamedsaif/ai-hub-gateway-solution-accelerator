{
  "$schema": "../schemas/agent-access-contract-request.schema.json",
  "contractMetadata": {
    "agentName": "HRAgent",
    "businessUnit": "HR",
    "environment": "DEV",
    "description": "HR Agent for employee assistance and document processing with PII protection",
    "owner": "hr-team@company.com"
  },
  "accessRequirements": {
    "models": [
      {
        "modelName": "gpt-4o",
        "tokensPerMinute": 10000,
        "tokenQuota": 100000,
        "tokenQuotaPeriod": "Monthly"
      },
      {
        "modelName": "text-embedding-3-large",
        "tokensPerMinute": 5000,
        "tokenQuota": 50000,
        "tokenQuotaPeriod": "Monthly"
      },
      {
        "modelName": "deepseek-r1",
        "tokensPerMinute": 3000,
        "tokenQuota": 30000,
        "tokenQuotaPeriod": "Monthly"
      }
    ],
    "globalLimits": {
      "tokensPerMinute": 15000,
      "tokenQuota": 150000,
      "tokenQuotaPeriod": "Monthly"
    },
    "allowedBackends": [
      "openai-backend-0"
    ]
  },
  "contentSafety": {
    "enabled": true,
    "backendId": "content-safety-backend",
    "shieldPrompt": true,
    "categories": [
      {
        "name": "Hate",
        "threshold": 4
      },
      {
        "name": "Violence",
        "threshold": 4
      },
      {
        "name": "Sexual",
        "threshold": 4
      },
      {
        "name": "SelfHarm",
        "threshold": 4
      }
    ],
    "applicableModels": [
      "gpt-4o"
    ]
  },
  "piiHandling": {
    "enabled": true,
    "confidenceThreshold": 0.75,
    "detectionLanguage": "en",
    "entityCategoryExclusions": [
      "PersonType",
      "CADriversLicenseNumber"
    ],
    "customRegexPatterns": [
      {
        "pattern": "\\b\\d{4}[- ]?\\d{4}[- ]?\\d{4}[- ]?\\d{4}\\b",
        "category": "CREDIT_CARD"
      },
      {
        "pattern": "\\b[A-Z]{2}\\d{6}[A-Z]\\b",
        "category": "PASSPORT_NUMBER"
      },
      {
        "pattern": "\\b\\d{3}[-]?\\d{4}[-]?\\d{7}[-]?\\d{1}\\b",
        "category": "NATIONAL_ID"
      }
    ],
    "stateSaving": true
  },
  "usageTracking": {
    "customDimensions": [
      "departmentId",
      "employeeRegion"
    ],
    "trackEndUserId": true,
    "trackSessionId": true,
    "trackAppId": true
  },
  "alerts": {
    "throttlingEvents": true,
    "contentSafetyViolations": true,
    "unauthorizedAccess": true
  }
}
