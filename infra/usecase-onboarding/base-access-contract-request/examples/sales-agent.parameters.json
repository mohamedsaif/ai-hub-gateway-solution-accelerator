{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "contractRequestJson": {
      "value": {
        "$schema": "../schemas/agent-access-contract-request.schema.json",
        "contractMetadata": {
          "agentName": "SalesAgent",
          "businessUnit": "Sales",
          "environment": "DEV",
          "description": "Sales Agent for customer engagement and document analysis",
          "owner": "sales-team@company.com"
        },
        "accessRequirements": {
          "models": [
            {
              "modelName": "gpt-4o"
            },
            {
              "modelName": "text-embedding-3-large"
            }
          ],
          "globalLimits": {
            "tokensPerMinute": 1000,
            "tokenQuota": 100000,
            "tokenQuotaPeriod": "Monthly"
          }
        },
        "contentSafety": {
          "enabled": false
        },
        "piiHandling": {
          "enabled": false
        },
        "usageTracking": {
          "trackEndUserId": false,
          "trackSessionId": false,
          "trackAppId": false
        },
        "alerts": {
          "throttlingEvents": false,
          "contentSafetyViolations": false,
          "unauthorizedAccess": false
        }
      }
    },
    "apim": {
      "value": {
        "subscriptionId": "<sub-guid>",
        "resourceGroupName": "<apim-rg>",
        "name": "<apim-name>"
      }
    },
    "keyVault": {
      "value": {
        "subscriptionId": "<sub-guid>",
        "resourceGroupName": "<kv-rg>",
        "name": "<kv-name>"
      }
    },
    "existingServices": {
      "value": {
        "OAI": {
          "apiResourceIds": [
            "/subscriptions/<sub-guid>/resourceGroups/<apim-rg>/providers/Microsoft.ApiManagement/service/<apim-name>/apis/azure-openai-service-api"
          ]
        }
      }
    }
  }
}
