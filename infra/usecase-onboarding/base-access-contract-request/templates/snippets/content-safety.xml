<!-- Adding content safety with customized option for the product -->
<!-- Only enforce content safety for specific deployments that handle user-generated content -->
<choose>
  <when condition="@(new [] { {{APPLICABLE_MODELS}} }.Contains(context.Request.MatchedParameters["deployment-id"] ?? String.Empty))">
    <!-- Failure to pass content safety will result in 403 error -->
    <llm-content-safety backend-id="{{BACKEND_ID}}" shield-prompt="{{SHIELD_PROMPT}}">
      <categories output-type="EightSeverityLevels">
        {{CATEGORIES}}
      </categories>
    </llm-content-safety>
  </when>
</choose>
