<policies>
    <inbound>
        <base />
        
        <!--
            Unified AI Gateway API Policy
            Purpose: Wildcard API that routes all AI requests through the shared Unified AI Gateway pipeline.
            Supports OpenAI, Inference, Responses, and OpenAI v1 API formats via a single endpoint.

            Flow:
            1. Load and cache metadata configuration (models, api-types, cache & timeout settings)
            2. Process incoming request to extract routing context (api-type, model-id, path)
            3. Validate Entra ID authentication (if enabled at product or global level)
            4. Validate model access against product-level allowedModels RBAC
            5. Select backend pool with RBAC filtering and configure authentication
            6. Build correct backend URL path based on api-type and pool-type
            7. Configure timeout from metadata-config model settings
            8. Configure collecting usage metrics

            Configuration:
            - Model RBAC: Set allowedModels in product policy (comma-separated model names)
            - Pool RBAC: Set allowedBackendPools in product policy (comma-separated pool IDs, empty = all allowed)
            - Default pool: Set defaultBackendPool in product policy (empty = error on no match)
            - Backend pool definitions are auto-generated in metadata-config fragment
        -->
        
        <!-- Validate product context -->
        <choose>
            <when condition="@(context.Product == null)">
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>@{
                        return new JObject(
                            new JProperty("error", new JObject(
                                new JProperty("message", "A valid subscription key is required to access the Unified AI Gateway."),
                                new JProperty("type", "authentication_error"),
                                new JProperty("code", "subscription_required")
                            ))
                        ).ToString();
                    }</set-body>
                </return-response>
            </when>
        </choose>

        <!-- Step 1: Load and cache metadata configuration -->
        <include-fragment fragment-id="metadata-config" />
        <include-fragment fragment-id="central-cache-manager" />

        <!-- Step 2: Process request to extract routing context -->
        <include-fragment fragment-id="request-processor" />

        <!-- Step 3: Validate Entra ID authentication (if enabled) -->
        <include-fragment fragment-id="aad-auth" />

        <!-- Remove api-key header to prevent it from being passed to backend endpoints -->
        <set-header name="api-key" exists-action="delete" />

        <!-- Step 4-5: RBAC and backend selection handled by product policy (allowedModels, allowedBackendPools) and backend-selector -->
        <include-fragment fragment-id="backend-selector" />

        <!-- Step 6: Build backend URL path -->
        <include-fragment fragment-id="path-builder" />

        <!-- Step 7: Configure timeout from model metadata -->
        <choose>
            <when condition="@{
                var modelId = context.Variables.GetValueOrDefault<string>("model-id", "");
                return modelId != "non-llm-request" && modelId != "not-applicable";
            }">
                <set-variable name="backend-timeout" value="@{
                    var modelId = context.Variables.GetValueOrDefault<string>("model-id", "");
                    var models = context.Variables.GetValueOrDefault<JObject>("config-models");
                    var timeoutSettings = context.Variables.GetValueOrDefault<JObject>("config-timeout-settings");
                    var isStreaming = context.Variables.GetValueOrDefault<string>("is-streaming", "false") == "true";
                    
                    int timeout = 120;
                    if (models != null && models[modelId] != null && models[modelId]["timeout"] != null) {
                        timeout = models[modelId]["timeout"].Value<int>();
                    }

                    if (isStreaming && timeoutSettings != null && timeoutSettings["streaming-multiplier"] != null) {
                        timeout = timeout * timeoutSettings["streaming-multiplier"].Value<int>();
                    }

                    return timeout.ToString();
                }" />
            </when>
        </choose>

        <!-- Step 8: Configure collecting usage metrics -->
        <include-fragment fragment-id="set-llm-usage" />
    </inbound>
    <backend>
        <!--
            Backend Retry Logic
            Purpose: Implements retry mechanism for transient failures (429 throttling, 503 service unavailable)
            
            Configuration:
            - Retry count: Set to one less than number of backends in pool to try all backends
            - Condition: Retries on 429 (throttling) or 503 (except when backend pool is unavailable)
            - Strategy: First fast retry with zero interval, buffer request body for replay
        -->
        <retry count="2" interval="0" first-fast-retry="true" condition="@(context.Response.StatusCode == 429 || (context.Response.StatusCode >= 500 && !context.Response.StatusReason.Contains("Backend pool") && !context.Response.StatusReason.Contains("is temporarily unavailable")))">
            <forward-request buffer-request-body="true" />
        </retry>
    </backend>
    <outbound>
        <base />
        <!-- Diagnostic headers for troubleshooting -->
        <include-fragment fragment-id="diagnostic-headers" />
    </outbound>
    <on-error>
        <base />
        <!--
            Error Handling
            Purpose: Pushes custom metrics for errors to enable Azure Monitor alerts
        -->
        <include-fragment fragment-id="raise-throttling-events" />
        <include-fragment fragment-id="diagnostic-headers" />
    </on-error>
</policies>
