{
  "$schema": "../schemas/agent-access-contract-request.schema.json",
  "contractMetadata": {
    "agentName": "SalesAgent",
    "businessUnit": "Sales",
    "environment": "DEV",
    "description": "Sales Agent for customer engagement and document analysis",
    "owner": "sales-team@company.com"
  },
  "accessRequirements": {
    "models": [
      {
        "modelName": "gpt-4o"
      },
      {
        "modelName": "text-embedding-3-large"
      }
    ],
    "globalLimits": {
      "tokensPerMinute": 1000,
      "tokenQuota": 100000,
      "tokenQuotaPeriod": "Monthly"
    }
  },
  "contentSafety": {
    "enabled": false
  },
  "piiHandling": {
    "enabled": false
  },
  "usageTracking": {
    "trackEndUserId": false,
    "trackSessionId": false,
    "trackAppId": false
  },
  "alerts": {
    "throttlingEvents": false,
    "contentSafetyViolations": false,
    "unauthorizedAccess": false
  }
}
