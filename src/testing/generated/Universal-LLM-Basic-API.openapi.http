### Gets chat completions for the provided chat messages.
POST {{baseUrl}}/chat/completions?api-version=2024-05-01-preview
Content-Type: application/json
api-key: {{apiKey}}

{
  "model": "gpt-4o",
  "messages": [
    {
      "role": "system",
      "content": "You are a helpful assistant"
    },
    {
      "role": "user",
      "content": "How are you?"
    }
  ],
  "max_tokens": 50
}

### Return the embedding vectors for given text prompts.
POST {{baseUrl}}/embeddings?api-version=2024-05-01-preview
Content-Type: application/json
api-key: {{apiKey}}

{
  "model": "text-embedding-ada-002",
  "input": "How are you?"
}

