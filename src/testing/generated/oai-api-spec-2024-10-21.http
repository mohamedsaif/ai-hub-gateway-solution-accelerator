@baseUrl = {{openai_api_base_url}}
@apiKey = ""

### Creates a completion for the provided prompt, parameters and chosen model.
POST {{baseUrl}}/deployments/{deployment-id}/completions
Content-Type: application/json
api-key: {{apiKey}}

{
  "prompt": "Negate the following sentence.The price for bubblegum increased on thursday.\n\n Negated Sentence:",
  "max_tokens": 50
}

### Get a vector representation of a given input that can be easily consumed by machine learning models and algorithms.
POST {{baseUrl}}/deployments/{deployment-id}/embeddings?api-version=2024-10-21
Content-Type: application/json
api-key: {{apiKey}}

{
  "input": "APIM love OpenAI"
}

### Creates a completion for the chat message
POST {{baseUrl}}/deployments/{deployment-id}/chat/completions?api-version=2024-10-21
Content-Type: application/json
api-key: {{apiKey}}

{
  "model": "chat",
  "messages": [
    {
      "role": "system",
      "content": "You are a helpful assistant that responds in Markdown. Help me with my math homework!"
    },
    {
      "role": "user",
      "content": "How to calculate the distance between earth and moon?"
    }
  ]
}

### Transcribes audio into the input language.
