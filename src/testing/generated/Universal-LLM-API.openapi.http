### Create the structure of an evaluation that can be used to test a model's performance. [Evals]
POST {{baseUrl}}/evals
Content-Type: application/json
api-key: {{apiKey}}

{
  "name": "string",
  "metadata": {},
  "data_source_config": {
    "type": "custom",
    "item_schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"name\": {\"type\": \"string\"},\n    \"age\": {\"type\": \"integer\"}\n  },\n  \"required\": [\"name\", \"age\"]\n}\n",
    "include_sample_schema": false
  },
  "testing_criteria": [
    {
      "type": "label_model",
      "name": "string",
      "model": "string",
      "input": [
        {
          "role": "string",
          "content": "string"
        }
      ],
      "labels": [
        "string"
      ],
      "passing_labels": [
        "string"
      ]
    }
  ]
}

